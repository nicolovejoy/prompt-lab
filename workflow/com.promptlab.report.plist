<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.promptlab.report</string>

    <key>ProgramArguments</key>
    <!-- No `source .env && …` here. generate-report.py calls load_env() itself
         (generate-report.py:134), so the source was always redundant, and the
         `&&` short-circuit is what killed this job for four months once and
         again after the 2026-08-13 rebuild: the mini has no .env at all (only
         .env.local), so `source` failed and python never ran. Silently. -->
    <array>
        <string>/bin/sh</string>
        <string>__REPO_DIR__/workflow/run-nightly.sh</string>
        <string>__REPO_DIR__/generate-report.log</string>
        <string>__PYTHON3__</string>
        <string>__REPO_DIR__/generate-report.py</string>
        <string>30</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Day</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>3</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Day</key>
            <integer>16</integer>
            <key>Hour</key>
            <integer>3</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>__REPO_DIR__/generate-report.log</string>

    <key>StandardErrorPath</key>
    <string>__REPO_DIR__/generate-report.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
