diff -ruN a/workflow/bin/_gc_session_identity.sh b/workflow/bin/_gc_session_identity.sh
--- a/workflow/bin/_gc_session_identity.sh	1969-12-31 16:00:00
+++ b/workflow/bin/_gc_session_identity.sh	2026-09-13 11:05:52
@@ -0,0 +1,40 @@
+#!/bin/bash
+# Shared invocation identity for gc-read/gc-write and the Claude prompt hook.
+
+gc_session_identity() {
+  if [ -n "${CODEX_THREAD_ID:-}" ]; then
+    printf 'codex:%s' "$CODEX_THREAD_ID"
+  elif [ -n "${GC_SESSION_SCOPE:-}" ]; then
+    printf 'launch:%s' "$GC_SESSION_SCOPE"
+  fi
+}
+
+gc_session_pointer() {
+  local project="$1" identity="${2:-}" suffix=""
+  if [ -n "$identity" ]; then
+    # Native thread ids and launcher UUIDs use this alphabet. Reject anything
+    # else instead of allowing traversal or mapping distinct identities onto
+    # one lossy sanitized filename.
+    case "$identity" in *[!A-Za-z0-9:._-]*) return 2 ;; esac
+    [ "${#identity}" -le 160 ] || return 2
+    suffix="-$identity"
+  fi
+  printf '%s/.claude/state/current-session-%s%s' "$HOME" "$project" "$suffix"
+}
+
+gc_read_session_pointer() {
+  local db="$1" project="$2" pointer="$3" sid=""
+  [ -f "$pointer" ] || return 0
+  sid="$(tr -dc '0-9' < "$pointer" 2>/dev/null || true)"
+  [ -n "$sid" ] || return 0
+  # A pointer is valid only for its resolved project.
+  sqlite3 "$db" "SELECT id FROM sessions WHERE id=$sid AND project='$(printf '%s' "$project" | sed "s/'/''/g")';"
+}
+
+gc_write_session_pointer() {
+  local pointer="$1" sid="$2" tmp
+  mkdir -p "$(dirname "$pointer")"
+  tmp="${pointer}.tmp.$$"
+  printf '%s\n' "$sid" > "$tmp"
+  mv "$tmp" "$pointer"
+}
